# Choose the provider used by the notebooks: groq or mistral.
LLM_PROVIDER=groq

# Groq is the primary provider for this repository.
# Create a key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Mistral is the alternative provider.
# Create a key from https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional: keep evaluation notebooks cheap while testing.
MAX_EVAL_CASES=3
